# ==============================================================================
# AEGIS Fraud Detection System - Environment Configuration
# ==============================================================================

# Database Configuration (Docker Compose internal network)
POSTGRES_USER=replace_with_a_local_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=aegis_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://replace_with_a_local_user:replace_with_a_local_password@db:5432/aegis_db

# Host port mapping for PostgreSQL (when connecting from host tools e.g. pgAdmin, DBeaver)
# Securely bound to localhost loopback (127.0.0.1:5434) so it is never exposed to the public internet.
POSTGRES_HOST_PORT=5434
# DATABASE_URL_HOST=postgresql+psycopg2://aegis_user:aegis_password@127.0.0.1:5434/aegis_db

# Redis Configuration (isolated inside Docker aegis_network with no host port published)
REDIS_HOST=redis
REDIS_PORT=6379

# Machine Learning Artifacts
ML_ARTIFACTS_DIR=/ml/artifacts

# Application Settings
APP_ENV=development
DEBUG=true

# Frontend Configuration
VITE_BACKEND_URL=http://backend:8000